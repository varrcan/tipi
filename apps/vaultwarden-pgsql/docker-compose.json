{
    "schemaVersion": 2,
    "services": [
        {
            "name": "vaultwarden",
            "image": "vaultwarden/server:1.37.2",
            "isMain": true,
            "internalPort": 80,
            "environment": [
                { "key": "WEBSOCKET_ENABLED", "value": "true" },
                { "key": "ADMIN_TOKEN", "value": "${VAULTWARDEN_ADMIN_PASSWORD}" },
                { "key": "DOMAIN", "value": "${VAULTWARDEN_DOMAIN}" },
                { "key": "SEND_ALLOWED", "value": "${VAULTWARDEN_SEND_ALLOWED}" },
                { "key": "SIGNUPS_ALLOWED", "value": "${VAULTWARDEN_SIGNUPS_ALLOWED}" },
                { "key": "SIGNUPS_VERIFY", "value": "${VAULTWARDEN_SIGNUPS_VERIFY}" },
                { "key": "INVITATIONS_ALLOWED", "value": "${VAULTWARDEN_INVITATIONS_ALLOWED}" },
                { "key": "INVITATIONS_ORG_NAME", "value": "${VAULTWARDEN_INVITATIONS_ORG_NAME}" },
                { "key": "EMERGENCY_ACCESS_ALLOWED", "value": "${VAULTWARDEN_EMERGENCY_ACCESS_ALLOWED}" },
                { "key": "DATABASE_URL", "value": "postgresql://${VAULTWARDEN_POSTGRES_USER}:${VAULTWARDEN_POSTGRES_PASSWORD}@vaultwarden-db:5432/${VAULTWARDEN_POSTGRES_DB}" },
                { "key": "SMTP_HOST", "value": "${VAULTWARDEN_SMTP_HOST}" },
                { "key": "SMTP_SECURITY", "value": "${VAULTWARDEN_SMTP_SECURITY}" },
                { "key": "SMTP_PORT", "value": "${VAULTWARDEN_SMTP_PORT}" },
                { "key": "SMTP_USERNAME", "value": "${VAULTWARDEN_SMTP_USERNAME}" },
                { "key": "SMTP_PASSWORD", "value": "${VAULTWARDEN_SMTP_PASSWORD}" },
                { "key": "SMTP_FROM", "value": "${VAULTWARDEN_SMTP_FROM}" },
                { "key": "SMTP_FROM_NAME", "value": "${VAULTWARDEN_SMTP_FROM_NAME}" }
            ],
            "volumes": [
                {
                    "hostPath": "${APP_DATA_DIR}/data/config",
                    "containerPath": "/data"
                }
            ]
        },
        {
            "name": "vaultwarden-db",
            "image": "postgres:17",
            "environment": [
                { "key": "POSTGRES_USER", "value": "${VAULTWARDEN_POSTGRES_USER}" },
                { "key": "POSTGRES_PASSWORD", "value": "${VAULTWARDEN_POSTGRES_PASSWORD}" },
                { "key": "POSTGRES_DB", "value": "${VAULTWARDEN_POSTGRES_DB}" }
            ],
            "volumes": [
                {
                    "hostPath": "${APP_DATA_DIR}/data/postgres",
                    "containerPath": "/var/lib/postgresql/data"
                }
            ],
            "healthCheck": {
                "interval": "5s",
                "timeout": "60s",
                "retries": 10,
                "test": "pg_isready -d postgres://${VAULTWARDEN_POSTGRES_USER}:${VAULTWARDEN_POSTGRES_PASSWORD}@vaultwarden-db:5432/${VAULTWARDEN_POSTGRES_DB}",
                "startPeriod": "5s"
            }
        }
    ],
    "$schema": "../dynamic-compose-schema.json"
}
